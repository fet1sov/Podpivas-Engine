<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PodpivasEngine.ViewModels"
             xmlns:models="using:PodpivasEngine.Models"
             x:Class="PodpivasEngine.Views.AssetBrowserView"
             x:DataType="vm:AssetBrowserViewModel">
    <Border x:Name="PanelRoot" Classes="panel" BorderThickness="0">
        <DockPanel>
            <Border DockPanel.Dock="Top"
                    Classes="panelHeader"
                    Cursor="SizeAll"
                    ToolTip.Tip="{DynamicResource Panel.Drag}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Text="{DynamicResource Panel.Assets}"
                               Classes="header"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="2"
                            Classes="icon"
                            FontSize="11"
                            Content="{DynamicResource Assets.Refresh}"
                            Command="{Binding RefreshCommand}" />
                </Grid>
            </Border>
            <Border DockPanel.Dock="Bottom"
                    Classes="panelHeader"
                    BorderThickness="0,1,0,0"
                    Padding="10,4">
                <TextBlock Text="{DynamicResource Assets.Hint}"
                           Classes="muted"
                           FontSize="10"
                           TextWrapping="Wrap" />
            </Border>
            <TextBlock Text="{DynamicResource Assets.Empty}"
                       Classes="muted"
                       Margin="10,8"
                       TextWrapping="Wrap"
                       IsVisible="{Binding !HasItems}" />
            <ListBox ItemsSource="{Binding Items}"
                     SelectedItem="{Binding Selected, Mode=TwoWay}"
                     DoubleTapped="OnItemActivated"
                     Background="Transparent"
                     BorderThickness="0"
                     Margin="4,4">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:AssetEntry">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Glyph}" Classes="glyph" />
                            <TextBlock Text="{Binding RelativePath}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
