<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PodpivasEngine.ViewModels"
             xmlns:views="using:PodpivasEngine.Views"
             x:Class="PodpivasEngine.Views.PreviewView"
             x:DataType="vm:PreviewViewModel">
    <UserControl.Resources>
        <DrawingBrush x:Key="Preview.Checker"
                      TileMode="Tile"
                      SourceRect="0,0,16,16"
                      DestinationRect="0,0,16,16">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#141414" Geometry="M0,0 H16 V16 H0 Z" />
                    <GeometryDrawing Brush="#1F1F1F" Geometry="M0,0 H8 V8 H0 Z M8,8 H16 V16 H8 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>

    <Border Classes="panel" BorderThickness="0">
        <DockPanel>
            <Border DockPanel.Dock="Top" Classes="panelHeader">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Text="{DynamicResource Panel.Preview}"
                               Classes="header"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Margin="10,0"
                               Text="{Binding FileName}"
                               Classes="value"
                               FontSize="11"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding KindLabel}"
                               Classes="muted"
                               FontSize="11"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border DockPanel.Dock="Bottom"
                    Classes="panelHeader"
                    BorderThickness="0,1,0,0"
                    Padding="10,4">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{DynamicResource Preview.Hint}"
                               Classes="muted"
                               FontSize="10" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Details}"
                               Classes="value"
                               FontSize="10" />
                </Grid>
            </Border>
            <Grid Background="{DynamicResource Editor.Viewport}">
                <Border Background="{StaticResource Preview.Checker}"
                        IsVisible="{Binding HasImage}"
                        Margin="12">
                    <Image Source="{Binding Image}"
                           Stretch="Uniform"
                           RenderOptions.BitmapInterpolationMode="MediumQuality" />
                </Border>
                <views:ModelPreview ModelPath="{Binding ModelPath}"
                                    IsVisible="{Binding HasModel}" />
                <TextBlock Text="{Binding Message}"
                           Classes="muted"
                           IsVisible="{Binding HasMessage}"
                           MaxWidth="420"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <TextBlock Text="{DynamicResource Preview.Empty}"
                           Classes="muted"
                           IsVisible="{Binding IsEmpty}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
