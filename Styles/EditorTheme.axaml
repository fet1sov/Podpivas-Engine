<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <SolidColorBrush x:Key="Editor.Background" Color="#0B0B0B" />
        <SolidColorBrush x:Key="Editor.Panel" Color="#0A0A0A" />
        <SolidColorBrush x:Key="Editor.PanelAlt" Color="#111111" />
        <SolidColorBrush x:Key="Editor.PanelHeader" Color="#101010" />
        <SolidColorBrush x:Key="Editor.Surface" Color="#1A1A1A" />
        <SolidColorBrush x:Key="Editor.Border" Color="#262626" />
        <SolidColorBrush x:Key="Editor.Foreground" Color="#D9D9D9" />
        <SolidColorBrush x:Key="Editor.Muted" Color="#8A8A8A" />
        <SolidColorBrush x:Key="Editor.Value" Color="#E4E4E4" />
        <SolidColorBrush x:Key="Editor.Accent" Color="#0EA800" />
        <SolidColorBrush x:Key="Editor.AccentSoft" Color="#0C2A09" />
        <SolidColorBrush x:Key="Editor.Hover" Color="#1C1C1C" />
        <SolidColorBrush x:Key="Editor.Viewport" Color="#080808" />
        <SolidColorBrush x:Key="Editor.Success" Color="#22C57C" />
        <SolidColorBrush x:Key="Editor.Lime" Color="#B7D34A" />
        <SolidColorBrush x:Key="Editor.Camera" Color="#4E79D5" />
        <SolidColorBrush x:Key="Editor.Orange" Color="#C98B52" />
        <SolidColorBrush x:Key="Editor.Warning" Color="#E5B84D" />

