        <StreamGeometry x:Key="Icon.ToolScale">m20 19 -8 -5.5L4 19 M12 4v9.5 M11 4a1 1 0 1 0 2 0 1 1 0 1 0 -2 0 M3 19a1 1 0 1 0 2 0 1 1 0 1 0 -2 0 M19 19a1 1 0 1 0 2 0 1 1 0 1 0 -2 0</StreamGeometry>
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource Editor.Background}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Editor.Foreground}" />
    </Style>

    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource Editor.Muted}" />
    </Style>

    <Style Selector="TextBlock.value">
        <Setter Property="Foreground" Value="{DynamicResource Editor.Value}" />
    </Style>

    <Style Selector="TextBlock.success">
        <Setter Property="Foreground" Value="{DynamicResource Editor.Success}" />
    </Style>

    <Style Selector="TextBlock.lime">
        <Setter Property="Foreground" Value="{DynamicResource Editor.Lime}" />
    </Style>

    <Style Selector="TextBlock.axis-x">
        <Setter Property="Foreground" Value="{DynamicResource Editor.Accent}" />
    </Style>

    <Style Selector="TextBlock.axis-y">
        <Setter Property="Foreground" Value="#E5484D" />
    </Style>

    <Style Selector="TextBlock.axis-z">
        <Setter Property="Foreground" Value="{DynamicResource Editor.Camera}" />
    </Style>

    <Style Selector="TextBlock.header">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Editor.Muted}" />
    </Style>

    <Style Selector="TextBlock.glyph">
        <Setter Property="Foreground" Value="{DynamicResource Editor.Accent}" />
    </Style>

    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{DynamicResource Editor.Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Editor.Border}" />
    </Style>

    <Style Selector="Border.panel.dropTarget">
        <Setter Property="Background" Value="{DynamicResource Editor.AccentSoft}" />
    </Style>

    <Style Selector="Border.panelHeader">
        <Setter Property="Background" Value="{DynamicResource Editor.PanelHeader}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Editor.Border}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="10,7" />
    </Style>

    <Style Selector="Button.icon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Foreground" Value="{DynamicResource Editor.Foreground}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="Button.icon:pointerover">
        <Setter Property="Background" Value="{DynamicResource Editor.Hover}" />
    </Style>

    <Style Selector="Button.icon.active">
        <Setter Property="Background" Value="{DynamicResource Editor.AccentSoft}" />
        <Setter Property="Foreground" Value="{DynamicResource Editor.Accent}" />
    </Style>

    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{DynamicResource Editor.Accent}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="Button.chip">
        <Setter Property="Background" Value="{DynamicResource Editor.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Editor.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="16,4" />
        <Setter Property="MinWidth" Value="60" />
        <Setter Property="Foreground" Value="{DynamicResource Editor.Foreground}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="Button.chip:pointerover">
        <Setter Property="Background" Value="{DynamicResource Editor.Hover}" />
    </Style>

    <Style Selector="Button.chip.active">
        <Setter Property="Background" Value="{DynamicResource Editor.AccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Editor.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Editor.Accent}" />
    </Style>

    <Style Selector="TextBox.field">
        <Setter Property="Background" Value="{DynamicResource Editor.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Editor.Border}" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TreeView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="TreeViewItem">
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="IsExpanded" Value="True" />
    </Style>

    <Style Selector="TreeViewItem:selected">
        <Setter Property="Background" Value="{DynamicResource Editor.AccentSoft}" />
        <Setter Property="Foreground" Value="{DynamicResource Editor.Accent}" />
    </Style>

    <Style Selector="TreeViewItem:selected /template/ Border">
        <Setter Property="Background" Value="{DynamicResource Editor.AccentSoft}" />
    </Style>

    <Style Selector="TabControl.tabs">
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="TabControl.tabs TabItem">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="12,2" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style Selector="ListBox.backends">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="ListBox.backends ListBoxItem">
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{DynamicResource Editor.Surface}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
</Styles>
